# Copy this file to .env and fill in real values. .env is git-ignored.

# Elle Bread admin password — required to log into /bread/admin.
ADMIN_PASSWORD=

# Secret used to sign session cookies. Falls back to a dev secret if unset.
SESSION_SECRET=

# Bakery time zone, used for the weekly bread day (defaults to Australia/Melbourne).
TIME_ZONE=Australia/Melbourne

# Order notification email addresses.
ORDER_RECIPIENT=elle@aemeredith.com
MAIL_FROM=orders@aemeredith.com

# SMTP delivery (production only; development logs mail instead).
# On Heroku the Mailgun add-on sets MAILGUN_SMTP_* automatically and the app
# prefers those; these generic names are a fallback for other providers.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# PostgreSQL connection string (production only).
DATABASE_URL=
