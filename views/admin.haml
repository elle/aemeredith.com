%main.site-main
  %section.section.admin-header
    .section__number 02
    .section__body.admin-header__bar
      %h1.admin__title Admin
      .admin__actions
        %a.admin__link{href: "/bread"} View public form →
        %form.admin__logout-form{action: "/bread/admin/session", method: "post"}
          %input{type: "hidden", name: "_method", value: "delete"}
          %input{type: "hidden", name: "authenticity_token", value: csrf_token}
          %button.admin__logout{type: "submit"} Log out

  %section.section.admin-announcement
    .section__number 03
    .section__body
      %h2.section__label Announcement
      %form.announcement-form{action: "/bread/admin/announcement", method: "post"}
        %input{type: "hidden", name: "_method", value: "put"}
        %input{type: "hidden", name: "authenticity_token", value: csrf_token}
        %p.announcement-form__hint Shown at the top of the order page. Leave blank to remove it.
        %textarea.announcement-form__input{name: "message", rows: 3}= announcement&.message
        %button.announcement-form__save{type: "submit"} Save announcement

  %section.section.admin-weekly
    .section__number 04
    .section__body
      %h2.section__label This week’s 3 breads
      %form.weekly-form{action: "/bread/admin/weekly-selection", method: "post"}
        %input{type: "hidden", name: "_method", value: "put"}
        %input{type: "hidden", name: "authenticity_token", value: csrf_token}
        %p.weekly-form__hint= "#{selected_ids.length} of 3 selected"
        - breads.each do |bread|
          %label.weekly-option
            %input{type: "checkbox", name: "bread_ids[]", value: bread["id"], checked: selected_ids.include?(bread["id"])}
            %span.weekly-option__name= bread["name"]
            %span.weekly-option__price= money(bread["price"])
        %button.weekly-form__save{type: "submit"} Save selection

  %section.section.admin-orders
    .section__number 05
    .section__body
      %h2.section__label Order history
      - if orders.any?
        .orders-table__scroll
          %table.orders-table
            %thead
              %tr
                %th Date
                %th Name
                %th Phone
                %th Order
                %th.orders-table__amount Total
            %tbody
              - orders.each do |order|
                %tr
                  %td.orders-table__nowrap= order.created_at.strftime("%b %-d, %Y")
                  %td= order.name
                  %td.orders-table__nowrap= order.phone
                  %td.orders-table__summary= order.order_items.map { |item| "#{item.quantity}× #{item.bread_name}" }.join(", ")
                  %td.orders-table__amount= money(order.total)
      - else
        %p.orders-empty No orders yet.
