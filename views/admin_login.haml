%main.site-main
  %section.section
    .section__number 02
    .section__body.admin-login
      %h1.section__label Admin login
      - if error
        %p.order-form__error= error
      %form.admin-login__form{action: "/bread/admin/session", method: "post"}
        %input{type: "hidden", name: "authenticity_token", value: csrf_token}
        %input.order-input{type: "password", name: "password", placeholder: "Password", autofocus: true}
        %button.order-submit{type: "submit"} Log in
      %a.bread-admin-link{href: "/bread"} ← Back to order form
