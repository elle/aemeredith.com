%main.site-main
  - current_announcement = announcement
  - if current_announcement
    .bread-announcement{role: "status"}
      %p.bread-announcement__text= current_announcement.message
  %section.section.bread-hero
    .section__number 01
    .section__body
      %h1.bread__title Elle Bread
      %p.bread__intro
        Small-batch sourdough bakes, made by hand each week.
        Pick your loaves below by Wednesday afternoon (as it takes 48 hours to make the bread)
        Pick up time on Friday is generally from 10am.

  %section.section.bread-order
    .section__number 02
    .section__body
      - if order
        %h2.section__label Order received
        .order-confirmation
          %p!= "Thanks #{order.name}, your order is in. I’ll text #{order.phone} to confirm pickup."
          %ul.order-confirmation__items
            - order.order_items.each do |item|
              %li= "#{item.quantity} × #{item.bread_name} — #{money(item.subtotal)}"
          %p.order-confirmation__total= "Total #{money(order.total)}"
          %a.link{href: "/bread"} Place another order
      - else
        - total = breads.sum { |bread| quantities.fetch(bread["id"], 0).to_i * bread["price"] }
        %h2.section__label= bread_day_heading
        %form.order-form{action: "/bread/orders", method: "post"}
          %input{type: "hidden", name: "authenticity_token", value: csrf_token}
          .order-hp{"aria-hidden": "true"}
            %label{for: "order-contact"} Leave this field blank
            %input#order-contact{type: "text", name: "email", tabindex: "-1", autocomplete: "off"}
          - breads.each do |bread|
            - quantity = quantities.fetch(bread["id"], 0).to_i
            .bread-row{data: { price: bread["price"] }}
              .bread-row__info
                .bread-row__name= bread["name"]
                .bread-row__price= money(bread["price"])
              .bread-row__stepper
                %button.stepper__btn{type: "button", data: { step: -1 }, "aria-label": "Remove one #{bread["name"]}"} −
                %span.stepper__qty= quantity
                %button.stepper__btn{type: "button", data: { step: 1 }, "aria-label": "Add one #{bread["name"]}"} +
                %input{type: "hidden", name: "items[#{bread["id"]}]", value: quantity}
          .order-total
            %span Total
            %span.order-total__amount= money(total)
          %p.order-form__error{role: "alert", "aria-live": "polite"}= error
          .order-fields
            %input.order-input{type: "text", name: "name", placeholder: "Your name", value: name}
            %input.order-input{type: "tel", name: "phone", placeholder: "Phone number", value: phone}
            %button.order-submit{type: "submit"} Place order
